# ============================================
# ChinaWiFiGo Apache Security Configuration
# Place this file in the root directory of the website
# Requires: Apache 2.4+ with mod_headers, mod_rewrite
# ============================================

# ============================================
# 1. SECURITY HEADERS (Server-Level Protection)
# ============================================

<IfModule mod_headers.c>
    # Strict Transport Security - Force HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Content Security Policy (CSP)
    # If CSP is already set via meta tag, this will override/duplicate
    # Remove this if using meta tag only, or keep for defense in depth
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https://api.exchangerate-api.com https://formsubmit.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
    
    # X-Frame-Options - Prevent clickjacking
    Header always set X-Frame-Options "DENY"
    
    # X-Content-Type-Options - Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # X-XSS-Protection - Legacy XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy - Limit referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy - Restrict browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), accelerometer=(), gyroscope=(), magnetometer=()"
    
    # Cross-Origin Policies
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    
    # Remove server information
    Header always unset X-Powered-By
    Header always unset Server
    
    # Cache control for sensitive files
    <FilesMatch "\.(htaccess|htpasswd|ini|log|sh)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ============================================
# 2. ACCESS CONTROL (Prevent Sensitive File Access)
# ============================================

# Deny access to hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to sensitive file extensions
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|orig|save)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to version control files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(svn|git|hg|bzr)/ - [F,L]
    RewriteRule ^(README|CHANGELOG|LICENSE|COPYING|INSTALL|CONTRIBUTING|SECURITY)\. - [F,L]
</IfModule>

# ============================================
# 3. DIRECTORY PROTECTION
# ============================================

# Disable directory browsing
Options -Indexes

# Disable server signature
ServerSignature Off

# Protect .htaccess itself
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# ============================================
# 4. REWRITE RULES (URL Normalization & Security)
# ============================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Force HTTPS (uncomment when SSL is available)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Remove trailing slashes (SEO & security)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]
    
    # Block common malicious requests
    RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
    RewriteRule ^(.*)$ - [F,L]
    
    # Block access to common attack paths
    RewriteCond %{REQUEST_URI} (\.env|wp-admin|wp-login|phpmyadmin|admin\.php|config\.php|setup\.php|install\.php) [NC]
    RewriteRule ^(.*)$ - [F,L]
</IfModule>

# ============================================
# 5. MIME TYPE SECURITY
# ============================================

# Force correct MIME types
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
</IfModule>

# ============================================
# 6. COMPRESSION (Performance & Security)
# ============================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml
</IfModule>

# ============================================
# 7. CACHING STRATEGY
# ============================================

<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML files - short cache (for quick updates)
    ExpiresByType text/html "access plus 1 hour"
    
    # Static assets - long cache
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# ============================================
# 8. CLICKJACKING PROTECTION (Frame Options)
# ============================================

# Already covered by X-Frame-Options above
# Additional JavaScript-based protection in security.js
